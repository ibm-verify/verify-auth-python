# IBM Verify Configuration
IBM_VERIFY_TENANT_URL=https://your-tenant.verify.ibm.com
IBM_VERIFY_OP_NAME=default

# Password Grant Client (User Authentication)
IBM_USER_CLIENT_ID=your-user-client-id
IBM_USER_CLIENT_SECRET=your-user-client-secret
IBM_USERNAME=your-username
IBM_PASSWORD=your-password

# Client Credentials Grant (Service-to-Service)
IBM_ACTOR_CLIENT_ID=your-actor-client-id
IBM_ACTOR_CLIENT_SECRET=your-actor-client-secret
IBM_ACTOR_SCOPE=openid             # scope for client_credentials and RAR verification

# Token Exchange Client
IBM_EXCHANGE_CLIENT_ID=your-exchange-client-id
IBM_EXCHANGE_CLIENT_SECRET=your-exchange-client-secret

# ============================================================================
# Authorization Code + PKCE (RFC 7636) — Public / Native / Web App
# ============================================================================
# Application type  : Custom OIDC / Relying Party
# Grant types       : Authorization code
# PKCE              : Required (S256)
# Client auth       : None  (public client — no secret)
# Redirect URI      : http://localhost:8080/callback  (must match exactly)
# Application URL   : http://localhost:8080  (required field in IBM Verify UI)
IBM_PKCE_CLIENT_ID=your-pkce-client-id
IBM_PKCE_CLIENT_SECRET=your-pkce-client-secret
IBM_PKCE_REDIRECT_URI=http://localhost:8080/callback
IBM_PKCE_SCOPE=openid profile email

# Device Code Client (CLI/IoT/TV Apps)
# NOTE: Device authorization flow requires a PUBLIC client (no secret)
IBM_DEVICE_CLIENT_ID=your-device-client-id
# IBM_DEVICE_CLIENT_SECRET=your-device-client-secret  # only set for confidential device clients
IBM_DEVICE_SCOPE=openid profile email

# API Client (Configuration Management)
IBM_CLIENT_ID=your-api-client-id
IBM_CLIENT_SECRET=your-api-client-secret

# JWT Authentication (requires public key registration)
# See JWT_ASSERTION_SETUP_GUIDE.md for complete setup instructions
IBM_JWT_CLIENT_ID=your-jwt-client-id
IBM_JWT_CLIENT_SECRET=your-jwt-client-secret
IBM_JWT_PRIVATE_KEY_PATH=../certs/private-key.pem
IBM_JWT_SUBJECT=your-subject-user@example.com
IBM_JWT_ISSUER=https://your-tenant.verify.ibm.com
IBM_JWT_KID=your-certificate-label  # certificate label from Security -> Certificates -> Details page

# Admin Token (optional)
IBM_AUTHZ_HEADER=Bearer your-admin-token-here

# ============================================================================
# Dynamic Client Registration (RFC 7591 / RFC 7592) — dcr_flow.py
# ============================================================================
# An admin-level access token that authorises POST /oauth2/register.
# Obtain one using the Client Credentials grant from an existing API client
# that has the "Manage applications" (or equivalent) admin scope.
IBM_DCR_INITIAL_ACCESS_TOKEN=your-admin-access-token-here

# Optional: explicit registration endpoint override.
# Leave blank to auto-resolve via OIDC discovery or the SDK default
# (/oauth2/register).
IBM_DCR_REGISTRATION_ENDPOINT=

# Interactive demo app (demo_app.py)
FLASK_SECRET_KEY=change-me-to-a-random-string  # set any long random value
DEMO_PORT=5001                                  # port for demo_app.py (default 5001)

# ============================================================================
# New fields: authorization_details + extra_params (RFC 9396 RAR)
# ============================================================================
# These are not read from .env by default — they are set directly in each
# sample script as Python variables so you can pass structured objects.
#
# authorization_details
#   Passed as the `authorization_details` keyword argument to any grant method.
#   The SDK JSON-encodes it automatically if you pass a list/dict.
#   Example value (set in the script, not here):
#     AUTHORIZATION_DETAILS = [
#         {"type": "payment_initiation", "instructedAmount": {"currency": "USD", "amount": "100.00"}},
#         {"type": "account_information", "access": {"accounts": ["read"], "balances": ["read"]}},
#     ]
#
# extra_params
#   Passed as the `extra_params` keyword argument to any grant method.
#   Keys/values are merged directly into the token or authorization request.
#   Example value (set in the script, not here):
#     EXTRA_PARAMS = {
#         "resource": "https://api.example.com",   # RFC 8707 resource indicator
#         "audience": "my-service",                # token audience hint
#         "acr_values": "urn:example:bronze",      # requested ACR (auth URL only)
#     }
